# GreenMetriX Backend — Example Environment Variables
# ====================================================
# Copy this as .env and replace placeholder values.
# This file IS safe to commit; it contains no real secrets.

GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
DATABASE_URL=sqlite:///./greenmetrix.db
JWT_SECRET=greenmetrix-secret-jwt-token-key-change-in-production-demo-32b
ENVIRONMENT=development
